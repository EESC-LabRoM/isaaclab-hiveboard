<?xml version="1.0"?>
<!--
  Sliding drawer: base + drawer on a prismatic joint along +X (pull toward the robot).
  Travel ends where the drawer pins reach the end of the guide slots (x = 33 mm);
  the joint limit enforces it, so the pins carry no collider. The drawer's one
  collider is decomposed by scripts/generate_newton_usd.py (a single hull
  would wrap its thin handle tab into a slanted phantom front).
  Generated from the upstream single-link Drawer_Assembly.urdf (dependencies/HiveBoard),
  which carries no joint between the parts. Meshes are the upstream ones.
-->
<robot name="Drawer_Assembly">
